{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=7168"
    }
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/bonnie-dream",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/process-recurring-invoices",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-invoice-overdue-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/intelligence-snapshots",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/social-publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/publish-linkedin",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/bonnie-morning-brief",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/sync-zoho-inbox",
      "schedule": "*/5 * * * *"
    }
  ]
}
