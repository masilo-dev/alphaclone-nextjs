{
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/bonnie-dream",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/process-recurring-invoices",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-invoice-overdue-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/intelligence-snapshots",
      "schedule": "0 4 * * *"
    }
  ]
}
