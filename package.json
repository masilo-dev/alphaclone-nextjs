{
  "name": "alphaclone-nextjs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "rm -rf app && cross-env NEXT_TELEMETRY_DISABLED=1 SERWIST_SUPPRESS_TURBOPACK_WARNING=1 NODE_OPTIONS=--max-old-space-size=12288 next build --webpack",
    "build:prod": "rm -rf app && cross-env NODE_OPTIONS=--max-old-space-size=12288 next build --webpack",
    "start": "node scripts/validate-production-env.mjs --warn-only && NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=4096}\" next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint",
    "typecheck": "rm -rf .next/types .next/dev/types && cross-env NODE_OPTIONS=--max-old-space-size=7168 tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.mjs",
    "guard:design-system": "node --import tsx scripts/design-system-guard.mjs",
    "validate:prod-guards": "npm run guard:design-system && node --import tsx --test tests/unit/metrics-and-canonical-routes.test.mjs",
    "test:e2e": "playwright test",
    "bonnie:worker": "tsx src/bonnie/worker.ts",
    "leads:worker": "tsx src/workers/lead-discovery-worker.ts",
    "bonnie:test": "node --import tsx --test tests/unit/bonnie-*.test.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "setup:verify": "node scripts/verify-setup.js",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "supabase:link": "npx supabase link",
    "supabase:push": "npx supabase db push",
    "supabase:reset": "npx supabase db reset",
    "migrate": "npx supabase db push",
    "migrate:check": "node scripts/check-migrations.js",
    "api:sweep-errors": "node scripts/sweep-api-errors.mjs",
    "guidance:compact": "node scripts/compact-guidance.mjs",
    "pentest": "node scripts/platform-pentest.mjs",
    "validate:mcp": "./node_modules/.bin/tsx scripts/validate-bonnie-mcp-tools.ts",
    "validate:social-catalog": "./node_modules/.bin/tsx scripts/validate-social-tool-catalog.ts",
    "test:mcp-connector": "node --import tsx --test tests/unit/mcp-chatgpt-connector.test.mjs",
    "audit:mcp": "node scripts/audit-mcp.mjs",
    "audit:mcp-exposure": "tsx scripts/audit-mcp-exposure.ts",
    "audit:mcp-inventory": "tsx scripts/generate-mcp-tool-inventory.ts",
    "audit:mcp-chatgpt": "tsx scripts/chatgpt-mcp-execution-audit.ts",
    "sync:chatgpt-submission": "node --import tsx scripts/sync-chatgpt-app-submission.mjs",
    "audit:inventory": "node scripts/generate-repository-inventory.mjs && node scripts/generate-production-audit-artifacts.mjs",
    "audit:production": "node scripts/audit-production-readiness.mjs",
    "audit:data": "tsx scripts/audit-data-integrity.ts",
    "audit:routes": "tsx scripts/audit-routes.ts",
    "migrate:encrypt-integrations": "tsx scripts/encrypt-integration-configs.ts",
    "validate:env": "node scripts/validate-production-env.mjs",
    "validate:production": "node scripts/validate-production-env.mjs",
    "test:mcp-compatibility": "node --import tsx --test tests/unit/mcp-universal-compat.test.mjs tests/unit/mcp-production-hardening.test.mjs",
    "test:oauth-multiclient": "node --import tsx --test tests/unit/mcp-oauth-multiclient-isolation.test.mjs tests/unit/mcp-production-hardening.test.mjs",
    "test:media-gateway": "node --import tsx --test tests/unit/mcp-connector-upgrade.test.mjs tests/unit/mcp-production-hardening.test.mjs",
    "test:tool-registry": "node --import tsx --test tests/unit/mcp-tool-registry-static-load.test.mjs tests/unit/mcp-tool-exposure-gate.test.mjs tests/unit/mcp-production-hardening.test.mjs",
    "chatgpt:annotate-connector": "node scripts/annotate-chatgpt-connector-tools.mjs"
  },
