+FROM public.project_templates template
+WHERE phase.template_id=template.id AND phase.tenant_id=template.tenant_id
+ AND template.template_key='website-development' AND template.metadata->>'system'='true'
+ AND phase.name IN ('Discovery','Design','Build','QA','Launch') AND NOT(coalesce(phase.metadata,'{}') ? 'auto_advance');
diff --git a/supabase/migrations/20261014162000_saved_contract_signature_hash_guard.sql b/supabase/migrations/20261014162000_saved_contract_signature_hash_guard.sql
new file mode 100644
index 0000000..794f071
--- /dev/null
+++ b/supabase/migrations/20261014162000_saved_contract_signature_hash_guard.sql
@@ -0,0 +1,137 @@
+-- One service-role-only transaction. No historical evidence is rewritten.
+create or replace function public.record_contract_signature_atomic(p_request jsonb)
+returns jsonb language plpgsql security invoker set search_path = public, pg_temp as $$
+declare
+  v_token public.contract_signing_tokens%rowtype;
+  v_contract public.contracts%rowtype;
+  v_party public.contract_parties%rowtype;
+  v_old_event public.signature_events%rowtype;
+  v_contract_id uuid := nullif(p_request->>'contractId','')::uuid;
+  v_actor uuid := nullif(p_request->>'userId','')::uuid;
+  v_role text := p_request->>'role';
+  v_email text := lower(btrim(coalesce(p_request->>'signerEmail','')));
+  v_name text := btrim(coalesce(p_request->>'signerName',''));
+  v_signature text := p_request->>'signatureDataUrl';
+  v_now timestamptz := clock_timestamp();
+  v_event_id uuid := gen_random_uuid();
+  v_hash text; v_seal text; v_content text; v_status text;
+  v_required integer; v_pending integer; v_party_count integer;
+  v_existing_signature text; v_existing_time timestamptz;
+begin
+  if coalesce((p_request->>'consentGiven')::boolean,false) is not true then
+    raise exception 'Electronic signature consent is required';
+  end if;
+  if v_email = '' or v_name = '' or v_signature is null or length(v_signature) = 0 or length(v_signature) > 2000000 then
+    raise exception 'Valid signer identity and signature evidence are required';
+  end if;
+  if nullif(p_request->>'signingToken','') is not null then
+    -- Discover context without a claim; contract lock serializes all its signing links.
+    select * into v_token from public.contract_signing_tokens where token = p_request->>'signingToken';
+    if not found then raise exception 'Invalid signing token'; end if;
+    v_contract_id := v_token.contract_id; v_role := v_token.signer_role;
+  end if;
+  if v_role not in ('client','admin') or v_role is null then raise exception 'Invalid signer role'; end if;
+  select * into v_contract from public.contracts where id = v_contract_id for update;
+  if not found then raise exception 'Contract not found'; end if;
+  if nullif(p_request->>'expectedTenantId','') is not null and v_contract.tenant_id is distinct from (p_request->>'expectedTenantId')::uuid then
+    raise exception 'Signing link does not belong to this contract tenant';
+  end if;
+  if v_token.id is not null then
+    select * into v_token from public.contract_signing_tokens where id = v_token.id for update;
+    v_now := clock_timestamp();
+    if v_token.tenant_id is distinct from v_contract.tenant_id or v_token.contract_id is distinct from v_contract.id then
+      raise exception 'Signing token tenant mismatch';
+    end if;
+    if v_token.revoked_at is not null then raise exception 'Signing link revoked'; end if;
+    if v_token.expires_at <= v_now then raise exception 'Signing link expired'; end if;
+    if lower(btrim(v_token.signer_email)) <> v_email then raise exception 'Signer email does not match this signing link'; end if;
+    if coalesce((v_token.metadata->>'review_only')::boolean,false) then raise exception 'This draft is for review only. Signature is not permitted.'; end if;
+  elsif v_actor is null then
+    raise exception 'Authenticated signer or signing token is required';
+  else
+    -- Actor id/email come only from the server's verified JWT. This service-role-only
+    -- invoker must not receive broad SELECT privileges on auth.users.
+    if v_role = 'admin' and not exists(select 1 from public.tenant_users where tenant_id=v_contract.tenant_id and user_id=v_actor and role in ('owner','admin','tenant_admin','super_admin')) then
+      raise exception 'Authenticated signer is not an authorized tenant administrator';
+    end if;
+  end if;
+  if v_contract.status in ('rejected','expired','void') then raise exception 'Contract is not available for signing'; end if;
+  if jsonb_typeof(v_contract.content) is distinct from 'string' then raise exception 'Contract content must be a canonical text document before signing'; end if;
+  v_content := v_contract.content #>> '{}';
+  v_hash := encode(sha256(convert_to(v_content,'UTF8')),'hex');
+  if nullif(v_contract.metadata->>'content_hash','') is not null and v_contract.metadata->>'content_hash' <> v_hash then
+    raise exception 'Contract content integrity check failed';
+  end if;
+  if nullif(p_request->>'expectedContentHash','') is not null and p_request->>'expectedContentHash' <> v_hash then
+    raise exception 'Contract changed since approval; review and approve the current document';
+  end if;
+  select count(*) into v_party_count from public.contract_parties where tenant_id=v_contract.tenant_id and contract_id=v_contract.id and lower(btrim(party_snapshot->>'email'))=v_email;
+  if v_party_count > 1 then raise exception 'Ambiguous signer party requires reconciliation'; end if;
+  select * into v_party from public.contract_parties where tenant_id=v_contract.tenant_id and contract_id=v_contract.id and lower(btrim(party_snapshot->>'email'))=v_email for update;
+  if v_party.id is not null and ((v_role='client' and v_party.role not in ('client','customer','counterparty','buyer')) or (v_role='admin' and v_party.role not in ('provider','admin','owner','supplier','service_provider'))) then
+    raise exception 'Signing role does not match the agreement party';
+  end if;
+  if v_party.id is null and exists(select 1 from public.contract_parties where tenant_id=v_contract.tenant_id and contract_id=v_contract.id and signature_required) then
+    raise exception 'Signer is not an authorized party to this agreement';
+  end if;
+  if v_actor is not null and v_role='client' and v_party.id is null and lower(coalesce(v_contract.metadata->>'client_email','')) <> v_email then
+    raise exception 'Authenticated signer is not an authorized party to this agreement';
+  end if;
+  -- Replay only an identical, recorded signature with the same validated identity.
+  select * into v_old_event from public.signature_events where contract_id=v_contract.id and event_type='signature_completed' and lower(signer_email)=v_email and signer_role=v_role order by created_at desc limit 1;
+  if v_old_event.id is not null then
+    if v_old_event.signature_data=v_signature and v_old_event.signer_name=v_name and
+       ((v_token.id is not null and v_token.used_at is not null and v_old_event.device_info->>'signing_token_id'=v_token.id::text) or
+        (v_token.id is null and v_old_event.signer_id=v_actor)) then
+      return jsonb_build_object('contract',to_jsonb(v_contract),'replayed',true,'signature_event_id',v_old_event.id);
+    end if;
+    raise exception 'This party has already signed. Existing signature evidence cannot be replaced.';
+  end if;
+  if v_token.used_at is not null then raise exception 'Signing link already used; evidence requires reconciliation'; end if;
+  v_existing_signature := case when v_role='client' then v_contract.client_signature else v_contract.admin_signature end;
+  v_existing_time := case when v_role='client' then v_contract.client_signed_at else v_contract.admin_signed_at end;
+  if (v_existing_signature is not null or v_existing_time is not null) and not exists(select 1 from public.signature_events where contract_id=v_contract.id and signer_role=v_role and event_type='signature_completed') then
+    raise exception 'Existing signature evidence requires reconciliation before this party can sign';
+  end if;
+  if v_party.signature_status='signed' or (v_party.id is null and (v_existing_signature is not null or v_existing_time is not null)) or v_contract.status in ('fully_signed','signed') then
+    raise exception 'This party has already signed. Existing signature evidence cannot be replaced.';
+  end if;
+  if v_contract.status not in ('sent','client_signed') then raise exception 'Contract is not available for signing'; end if;
+  if exists(select 1 from public.contract_parties where tenant_id=v_contract.tenant_id and contract_id=v_contract.id and signature_required and signing_order<v_party.signing_order and signature_status<>'signed') then
+    raise exception 'An earlier signer must complete their signature first';
+  end if;
+  v_seal := encode(sha256(convert_to(v_event_id::text || '|' || v_hash || '|' || v_email || '|' || v_now::text,'UTF8')),'hex');
+  insert into public.signature_events(id,contract_id,signer_id,signer_role,signer_name,signer_email,signer_ip,event_type,signature_data,authentication_method,intent_statement,device_info,content_hash_at_signing,tamper_seal,created_at)
+  values(v_event_id,v_contract.id,v_actor,v_role,v_name,v_email,p_request->>'ipAddress','signature_completed',v_signature,case when v_actor is null then 'email_token' else 'session' end,
+    'I, ' || v_name || ', intend to sign this document and agree to be legally bound by its terms.',
+    jsonb_build_object('user_agent',p_request->>'userAgent','timestamp',v_now,'signing_token_id',v_token.id),v_hash,v_seal,v_now);
+  insert into public.esignature_consents(user_id,contract_id,consent_given,consent_text,consent_method,ip_address,user_agent,created_at)
+  values(v_actor,v_contract.id,true,'Electronic Signature Disclosure and Consent accepted at time of signing.','checkbox',p_request->>'ipAddress',p_request->>'userAgent',v_now);
+  insert into public.contract_signature_events(tenant_id,contract_id,party_id,event_type,signer_email,signing_order,provider,provider_event_id,ip_address,user_agent,document_hash,evidence,occurred_at)
+  values(v_contract.tenant_id,v_contract.id,v_party.id,'signed',v_email,v_party.signing_order,'bonnie_esign',v_event_id::text,nullif(p_request->>'ipAddress','')::inet,p_request->>'userAgent',v_hash,
+    jsonb_build_object('signature_event_id',v_event_id,'authentication_method',case when v_actor is null then 'email_token' else 'session' end,'consent_given',true,'tamper_seal',v_seal),v_now);
+  if v_party.id is not null then
+    update public.contract_parties set signature_status='signed' where id=v_party.id and tenant_id=v_contract.tenant_id;
+  end if;
+  select count(*),count(*) filter(where signature_status<>'signed') into v_required,v_pending from public.contract_parties where tenant_id=v_contract.tenant_id and contract_id=v_contract.id and signature_required;
+  v_status := case when v_required>0 then case when v_pending=0 then 'fully_signed' else 'sent' end
+    when v_role='client' then case when v_contract.admin_signature is not null then 'fully_signed' else 'client_signed' end
+    else case when v_contract.client_signature is not null then 'fully_signed' else 'sent' end end;
+  update public.contracts set
+    client_signature=case when v_role='client' then coalesce(client_signature,v_signature) else client_signature end,
+    client_signed_at=case when v_role='client' then coalesce(client_signed_at,v_now) else client_signed_at end,
+    admin_signature=case when v_role='admin' then coalesce(admin_signature,v_signature) else admin_signature end,
+    admin_signed_at=case when v_role='admin' then coalesce(admin_signed_at,v_now) else admin_signed_at end,
+    status=v_status,lifecycle_status=case when v_status='fully_signed' then 'signed' else 'sent' end,
+    metadata=coalesce(metadata,'{}') || jsonb_build_object('content_hash',v_hash,'last_signing_ip',p_request->>'ipAddress','history',coalesce(metadata->'history','[]') || jsonb_build_array(jsonb_build_object('action','signed_by_'||v_role,'sub',coalesce(v_actor::text,'external_signer'),'ts',v_now))),updated_at=v_now
+    where id=v_contract.id and tenant_id=v_contract.tenant_id returning * into v_contract;
+  insert into public.contract_audit_trail(contract_id,action,actor_id,actor_role,actor_name,actor_email,ip_address,user_agent,details,created_at)
+  values(v_contract.id,'signature_completed',v_actor,v_role,v_name,v_email,p_request->>'ipAddress',p_request->>'userAgent',jsonb_build_object('tenant_id',v_contract.tenant_id,'signature_event_id',v_event_id,'status',v_status),v_now);
+  if v_token.id is not null then
+    update public.contract_signing_tokens set used_at=v_now,metadata=metadata || jsonb_build_object('signature_event_id',v_event_id,'signed_at',v_now) where id=v_token.id;
+  end if;
+  return jsonb_build_object('contract',to_jsonb(v_contract),'replayed',false,'signature_event_id',v_event_id);
+end;
+$$;
+revoke all on function public.record_contract_signature_atomic(jsonb) from public, anon, authenticated;
+grant execute on function public.record_contract_signature_atomic(jsonb) to service_role;
diff --git a/tests/integration/project-lifecycle-postgres.test.mjs b/tests/integration/project-lifecycle-postgres.test.mjs
new file mode 100644
index 0000000..17ba289
--- /dev/null
+++ b/tests/integration/project-lifecycle-postgres.test.mjs
@@ -0,0 +1,62 @@
+import {PGlite} from '@electric-sql/pglite';
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+const db=new PGlite();
+await db.exec(`CREATE ROLE authenticated;CREATE ROLE service_role;
+CREATE TABLE tenants(id uuid PRIMARY KEY);
+CREATE FUNCTION is_active_tenant_member(uuid) RETURNS boolean LANGUAGE sql AS $$ SELECT true $$;
+CREATE TABLE projects(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),tenant_id uuid,owner_id uuid,owner_name text,name text,category text,status text,current_stage text,progress numeric DEFAULT 0,description text,due_date date,client_id uuid,deal_id uuid,contract_id uuid,team uuid[],resources text[],is_public boolean,show_in_portfolio boolean,portal_enabled boolean,auto_invoice_enabled boolean,contract_status text,budget_used numeric,metadata jsonb DEFAULT '{}',created_by uuid,owner_user_id uuid,project_type text,progress_method text DEFAULT 'weighted_tasks',start_date date,portal_token text,image text,external_url text,budget numeric,budget_total numeric,estimated_completion_date date,deleted_at timestamptz,created_at timestamptz DEFAULT now(),updated_at timestamptz DEFAULT now());
+CREATE TABLE tasks(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),tenant_id uuid,project_id uuid,related_to_project uuid,milestone_id uuid,title text,description text,priority text,status text DEFAULT 'todo',weight numeric DEFAULT 1,progress_percent numeric DEFAULT 0,completed_at timestamptz,deleted_at timestamptz,created_by uuid,requires_approval boolean,start_date timestamptz,due_date timestamptz,position numeric,created_at timestamptz DEFAULT now());
+CREATE TABLE project_milestones(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),tenant_id uuid,project_id uuid,name text,description text,status text DEFAULT 'pending',progress_percent numeric DEFAULT 0,metadata jsonb DEFAULT '{}',deleted_at timestamptz,order_index int DEFAULT 0,target_date date,due_date timestamptz,created_by uuid,created_at timestamptz DEFAULT now(),updated_at timestamptz DEFAULT now());
+CREATE TABLE project_activity(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),tenant_id uuid,project_id uuid,actor_user_id uuid,action text,target_type text,target_id uuid,previous_value jsonb,new_value jsonb,source text,correlation_id text,created_at timestamptz DEFAULT now());
+CREATE TABLE tenant_users(tenant_id uuid,user_id uuid);
+CREATE TABLE project_client_approvals(id uuid DEFAULT gen_random_uuid(),tenant_id uuid,project_id uuid,task_id uuid,status text,title text);
+CREATE TABLE project_relationships(tenant_id uuid,project_id uuid,relationship_type text,target_type text,target_id uuid);
+CREATE TABLE project_comments(id uuid DEFAULT gen_random_uuid(),tenant_id uuid,project_id uuid,is_client boolean,author_name text);
+CREATE TABLE contracts(id uuid PRIMARY KEY,tenant_id uuid,client_id uuid,project_id uuid);
+CREATE TABLE deals(id uuid PRIMARY KEY,tenant_id uuid);
+CREATE TABLE business_clients(id uuid PRIMARY KEY,tenant_id uuid);
+CREATE TABLE task_dependencies(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),tenant_id uuid,task_id uuid,depends_on_task_id uuid,dependency_type text,lag_minutes int,created_by uuid, UNIQUE(tenant_id,task_id,depends_on_task_id,dependency_type));`);
+const root=new URL('../../',import.meta.url).pathname;
+// Run the real pre-existing template schema and function, not a mocked RPC.
+let foundation=fs.readFileSync(root+'supabase/migrations/20260911090000_project_template_foundation.sql','utf8');
+await db.exec(foundation.slice(0,foundation.indexOf('CREATE OR REPLACE FUNCTION public.seed_default_project_templates')));
+await db.exec(fs.readFileSync(root+'supabase/migrations/20260911103000_apply_project_template.sql','utf8'));
+await db.exec(fs.readFileSync(root+'supabase/migrations/20261014120548_project_lifecycle_consistency.sql','utf8'));
+const tenant='00000000-0000-0000-0000-000000000001',other='00000000-0000-0000-0000-000000000002';
+await db.query('INSERT INTO tenants VALUES ($1),($2)',[tenant,other]);
+const create=async(name,key,method='weighted_tasks',template=null)=> (await db.query('SELECT create_project_lifecycle($1,$2,$3,$4) AS result',[tenant,JSON.stringify({name,status:'Pending',progress_method:method}),key,template])).rows[0].result;
+let a=await create('Website','a');const id=a.project.id;
+assert.equal(a.created,true);assert.equal((await create('Website','a')).project.id,id);
+assert.equal((await db.query('SELECT count(*)::int AS n FROM project_activity WHERE project_id=$1',[id])).rows[0].n,1);
+assert.equal((await db.query('SELECT count(*)::int AS n FROM project_notification_outbox WHERE project_id=$1',[id])).rows[0].n,1);
+let taskIds=[];for(let i=0;i<4;i++){taskIds.push((await db.query('INSERT INTO tasks(tenant_id,related_to_project,title) VALUES($1,$2,$3) RETURNING id,project_id',[tenant,id,`task ${i}`])).rows[0].id)};
+await db.query("UPDATE tasks SET status='completed' WHERE id=$1",[taskIds[0]]);
+assert.equal(Number((await db.query('SELECT progress FROM projects WHERE id=$1',[id])).rows[0].progress),25);
+assert.ok((await db.query('SELECT completed_at FROM tasks WHERE id=$1',[taskIds[0]])).rows[0].completed_at);
+await db.query("UPDATE tasks SET status='completed' WHERE project_id=$1",[id]);
+let project=(await db.query('SELECT * FROM projects WHERE id=$1',[id])).rows[0];assert.equal(Number(project.progress),100);assert.equal(project.status,'Pending');
+const events=(await db.query("SELECT count(*)::int AS n FROM project_activity WHERE project_id=$1 AND action='task_completed'",[id])).rows[0].n;
+await db.query("UPDATE tasks SET status='completed' WHERE project_id=$1",[id]);
+assert.equal((await db.query("SELECT count(*)::int AS n FROM project_activity WHERE project_id=$1 AND action='task_completed'",[id])).rows[0].n,events);
+await assert.rejects(()=>db.query('INSERT INTO tasks(tenant_id,project_id,title) VALUES($1,$2,$3)',[other,id,'foreign']),/project_not_found_in_tenant/);
+let weighted=await create('Weighted','b');let wid=weighted.project.id;
+await db.query("INSERT INTO tasks(tenant_id,project_id,title,weight,status) VALUES($1,$2,'small',1,'completed'),($1,$2,'large',3,'todo')",[tenant,wid]);
+assert.equal(Number((await db.query('SELECT progress FROM projects WHERE id=$1',[wid])).rows[0].progress),25);
+await db.query("UPDATE projects SET progress_method='manual',progress=42 WHERE id=$1",[wid]);
+await db.query("UPDATE tasks SET status='completed' WHERE project_id=$1",[wid]);
+assert.equal(Number((await db.query('SELECT progress FROM projects WHERE id=$1',[wid])).rows[0].progress),42);
+const template=(await db.query("INSERT INTO project_templates(tenant_id,name) VALUES($1,'Website') RETURNING id",[tenant])).rows[0].id;
+const phase=(await db.query("INSERT INTO project_template_phases(tenant_id,template_id,name,metadata) VALUES($1,$2,'Discovery','{\"auto_advance\":true,\"next_stage\":\"Design\"}') RETURNING id",[tenant,template])).rows[0].id;
+await db.query("INSERT INTO project_template_tasks(tenant_id,template_id,phase_id,task_key,title) VALUES($1,$2,$3,'requirements','Requirements')",[tenant,template,phase]);
+let tpl=await create('Templated','c','weighted_tasks',template);let tid=tpl.project.id;
+assert.equal(tpl.templateApplication.result.created_tasks,1);assert.equal(tpl.templateApplication.result.created_milestones,1);
+await db.query("UPDATE projects SET metadata=metadata||'{\"execution_authorized\":true}' WHERE id=$1",[tid]);
+await db.query("UPDATE tasks SET status='completed' WHERE project_id=$1",[tid]);
+project=(await db.query('SELECT * FROM projects WHERE id=$1',[tid])).rows[0];assert.equal(project.current_stage,'Design');assert.equal(project.status,'Pending');
+assert.equal((await create('Templated','c','weighted_tasks',template)).duplicate,true);
+assert.equal((await db.query('SELECT count(*)::int AS n FROM tasks WHERE project_id=$1',[tid])).rows[0].n,1);
+await assert.rejects(()=>create('Broken','broken','weighted_tasks',other),/project_template_not_found/);
+assert.equal((await db.query("SELECT count(*)::int AS n FROM projects WHERE name='Broken'")).rows[0].n,0);
+console.log('PASS: actual PostgreSQL migration; create/retry, atomic template rollback, legacy task links, 25%/100%, weights, manual progress, completion timestamps, event/notification dedupe, milestones, authorized stage advance and tenant isolation.');
+await db.close();
diff --git a/tests/unit/durable-queue-health.test.mjs b/tests/unit/durable-queue-health.test.mjs
new file mode 100644
index 0000000..4e97194
--- /dev/null
+++ b/tests/unit/durable-queue-health.test.mjs
@@ -0,0 +1,13 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {diagnoseQueueHealth} from '../../src/lib/bonnie/runtime/queueHealth.ts';
+const now=Date.parse('2026-10-14T15:30:00Z');
+test('due unstarted work is flagged without claiming it failed or delivered',()=>{
+ const result=diagnoseQueueHealth([{id:'invoice',status:'READY',updated_at:'2026-10-14T15:07:46Z'}],now);
+ assert.equal(result.status,'stalled');assert.deepEqual(result.stalled_task_ids,['invoice']);assert.match(result.message,/do not resend/);
+});
+test('future, fresh, approval, completed and running tasks are not stalled queue work',()=>{
+ const tasks=[['future','READY','2026-10-15T00:00:00Z'],['approval','WAITING_FOR_APPROVAL'],['done','COMPLETED'],['running','RUNNING']].map(([id,status,scheduled_at])=>({id,status,scheduled_at,updated_at:'2026-10-01T00:00:00Z'}));
+ tasks.push({id:'fresh',status:'QUEUED',updated_at:'2026-10-14T15:29:59Z'});
+ assert.equal(diagnoseQueueHealth(tasks,now).status,'no_stalled_tasks');
+});
diff --git a/tests/unit/invoice-send-evidence.test.mjs b/tests/unit/invoice-send-evidence.test.mjs
new file mode 100644
index 0000000..6c37a16
--- /dev/null
+++ b/tests/unit/invoice-send-evidence.test.mjs
@@ -0,0 +1,22 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {deriveInvoiceSendVerification} from '../../src/services/automation/verificationService.ts';
+import {buildLlmExecutionTruth} from '../../src/lib/mcp/llmTruthfulResponse.ts';
+test('paid and issued invoice is not proof of an email send',()=>{
+ const result=deriveInvoiceSendVerification({id:'i',status:'paid',issued_at:'2026-10-14',canonical_delivery_status:'not_sent'},[]);
+ assert.equal(result.status,'not_sent');assert.equal(result.retryable,false);
+ const truth=buildLlmExecutionTruth({toolName:'verify_invoice_sent',parsedResult:{ok:true,data:result}});
+ assert.equal(truth.status,'REQUESTED');assert.equal(truth.may_claim_completed,false);
+});
+test('provider acceptance is distinct from final delivery',()=>{
+ const receipt={provider_msg_id:'provider-1',delivery_status:'PENDING'};
+ const accepted=deriveInvoiceSendVerification({id:'i',status:'sent'},[receipt]);
+ assert.equal(accepted.status,'provider_accepted');assert.equal(accepted.retryable,false);
+ assert.equal(buildLlmExecutionTruth({toolName:'verify_invoice_sent',parsedResult:{data:accepted}}).may_claim_completed,false);
+ assert.equal(deriveInvoiceSendVerification({id:'i'},[{...receipt,delivered_at:'2026-10-14'}]).status,'verified');
+});
+test('bounce, unknown and queue never suggest a blind retry',()=>{
+ assert.equal(deriveInvoiceSendVerification({id:'i'},[{provider_msg_id:'p',bounced_at:'2026-10-14'}]).status,'failed');
+ assert.equal(deriveInvoiceSendVerification({id:'i',status:'sent'},[]).status,'unknown');
+ assert.equal(deriveInvoiceSendVerification({id:'i',canonical_delivery_status:'queued'},[]).status,'queued');
+});
diff --git a/tests/unit/invoice-worker-kick.test.mjs b/tests/unit/invoice-worker-kick.test.mjs
new file mode 100644
index 0000000..bdf254b
--- /dev/null
+++ b/tests/unit/invoice-worker-kick.test.mjs
@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {scheduleDurableWorkerKick} from '../../src/lib/bonnie/runtime/workerKick.ts';
+test('response schedules only the persisted invoice task and never executes inline', async()=>{
+ let callback; const calls=[];
+ await scheduleDurableWorkerKick({tenantId:'tenant-a',taskId:'invoice-task'}, {
+  schedule: work=>{callback=work}, process:async(...args)=>calls.push(args),log:()=>assert.fail('unexpected error')
+ });
+ assert.equal(calls.length,0);
+ await callback();
+ assert.deepEqual(calls,[[1,{tenantId:'tenant-a',taskId:'invoice-task'}]]);
+});
+test('worker failure is visible without enqueueing or resending the invoice',async()=>{
+ let callback;let attempts=0;const logs=[];
+ await scheduleDurableWorkerKick({tenantId:'t',taskId:'i'}, {
+  schedule:work=>{callback=work},process:async()=>{attempts++;throw new Error('claim failed')},log:error=>logs.push(error.message)
+ });
+ await callback();assert.equal(attempts,1);assert.deepEqual(logs,['claim failed']);
+});
+test('unavailable request context leaves durable poller ownership and logs the failure',async()=>{
+ let processed=false;const logs=[];
+ await scheduleDurableWorkerKick({tenantId:'t',taskId:'i'}, {
+  schedule:()=>{throw new Error('no request context')},process:async()=>{processed=true},log:error=>logs.push(error.message)
+ });
+ assert.equal(processed,false);assert.deepEqual(logs,['no request context']);
+});
+
+test('shared kick continues other persisted tasks after one worker error',async()=>{
+ let callback;const calls=[];const logs=[];
+ await scheduleDurableWorkerKick([{tenantId:'a',taskId:'email'},{tenantId:'a',taskId:'social'}], {
+  schedule:work=>{callback=work},process:async(_,scope)=>{calls.push(scope.taskId);if(scope.taskId==='email')throw new Error('lookup failed')},log:error=>logs.push(error.message)
+ });
+ await callback();assert.deepEqual(calls,['email','social']);assert.deepEqual(logs,['lookup failed']);
+});
diff --git a/tests/unit/project-lifecycle-notifications.test.mjs b/tests/unit/project-lifecycle-notifications.test.mjs
new file mode 100644
index 0000000..9d72c02
--- /dev/null
+++ b/tests/unit/project-lifecycle-notifications.test.mjs
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {projectNotificationSuppression,projectEventCopy,processProjectNotificationOutbox} from '../../src/lib/projects/projectNotificationOutbox.ts';
+import {contractIsFullyExecuted} from '../../src/lib/contracts/projectExecutionAuthorization.ts';
+function database(rows) {
+ return {from(table) {let filters=[],patch,max=Infinity;const q={select(){return q},order(){return q},limit(n){max=n;return q},eq(k,v){filters.push(r=>r[k]===v);return q},lt(k,v){filters.push(r=>r[k]!=null && r[k]<v);return q},lte(k,v){filters.push(r=>r[k]<=v);return q},is(k,v){filters.push(r=>(r[k]??null)===v);return q},not(k,op,v){filters.push(r=>(r[k]??null)!==v);return q},update(v){patch=v;return q},
+ async maybeSingle(){const result=await q;return {...result,data:result.data[0] || null}},then(resolve,reject){const found=(rows[table] || []).filter(r=>filters.every(f=>f(r))).slice(0,max);if(patch)found.forEach(r=>Object.assign(r,patch));return Promise.resolve({error:null,data:structuredClone(found)}).then(resolve,reject)}};return q}};
+}
+const policy={project_notifications:{enabled:true,transactional_authorized:true}};
+test('QA/import emails are suppressed even when transactional notifications are enabled',()=>{
+ assert.equal(projectNotificationSuppression({name:'QA TEST — Website',metadata:{}},policy,{},'project_created'),'test_or_historical_record');
+ assert.equal(projectNotificationSuppression({metadata:{historical_import:true}},policy,{},'project_created'),'test_or_historical_record');
+ assert.equal(projectNotificationSuppression({metadata:{}},{},{},'project_created'),'transactional_notifications_not_authorized');
+ assert.equal(projectNotificationSuppression({metadata:{}},policy,{projects:{email_client:false}},'project_created'),'tenant_client_notifications_disabled');
+});
+test('activation wording requires recorded execution authorization',()=>{
+ assert.equal(projectEventCopy({action:'project_status_changed',new_value:{status:'Active'}}),null);
+ assert.match(projectEventCopy({action:'project_status_changed',new_value:{status:'Active',execution_authorized:true}}).title,/started/);
+ assert.equal(projectEventCopy({action:'task_completed'}),null);
+});
+test('partial client signature does not authorize contract execution',async()=>{
+ const db=database({contracts:[{id:'c',tenant_id:'t',status:'client_signed'}],contract_parties:[{tenant_id:'t',contract_id:'c',signature_required:true,signature_status:'signed'},{tenant_id:'t',contract_id:'c',signature_required:true,signature_status:'pending'}]});
+ assert.equal(await contractIsFullyExecuted(db,'t','c'),false);
+ assert.equal(await contractIsFullyExecuted(db,'foreign','c'),false);
+});
+function fixture(){return {project_notification_outbox:[{id:'o',tenant_id:'t',project_id:'p',event_id:'e',event_type:'project_created',status:'queued',attempts:0,next_attempt_at:'2020',created_at:'2020'}],projects:[{id:'p',tenant_id:'t',client_id:'c',name:'Website',status:'Pending',metadata:{}}],tenants:[{id:'t',settings:policy}],tenant_notification_policies:[],project_activity:[{id:'e',tenant_id:'t',action:'project_created'}],business_clients:[{id:'c',tenant_id:'t',name:'Test recipient',email:'controlled@example.test',is_active:true}]};}
+const brand=async()=>({isPlatformFallback:false,brand:{tradingName:'Tenant Business'},replyToEmail:'support@example.test'});
+test('provider acceptance stays accepted and a replay never sends twice',async()=>{
+ const rows=fixture();let sends=0;const services={branding:brand,send:async()=>{sends++;return {success:true,deliveryStatus:'provider_accepted',emailId:'provider-id',canonicalMessageId:'m'}}};const db=database(rows);
+ await processProjectNotificationOutbox(10,db,services);assert.equal(rows.project_notification_outbox[0].status,'provider_accepted');
+ await processProjectNotificationOutbox(10,db,services);assert.equal(sends,1);
+ rows.email_messages=[{id:'m',tenant_id:'t',delivered_at:'2026-10-14',delivery_status:'delivered'}];
+ await processProjectNotificationOutbox(10,db,services);assert.equal(rows.project_notification_outbox[0].status,'delivered');assert.equal(sends,1);
+});
+test('ambiguous provider outcome goes to reconciliation and is never resent',async()=>{
+ const rows=fixture();let sends=0;const services={branding:brand,send:async()=>{sends++;throw new Error('timeout')}};const db=database(rows);
+ await processProjectNotificationOutbox(10,db,services);await processProjectNotificationOutbox(10,db,services);
+ assert.equal(rows.project_notification_outbox[0].status,'needs_reconciliation');assert.equal(sends,1);
+});
+test('disabled policy prevents contacting the provider',async()=>{
+ const rows=fixture();rows.tenants[0].settings={};let sends=0;
+ await processProjectNotificationOutbox(10,database(rows),{branding:brand,send:async()=>{sends++;return {success:true}}});
+ assert.equal(rows.project_notification_outbox[0].status,'suppressed');assert.equal(sends,0);
+});
