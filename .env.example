# AlphaClone local environment
# Copy to `.env.local` and fill values from your Supabase project + app secrets.
#   cp .env.example .env.local
# Then restart: npm run dev

# --- Required for login / auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional legacy aliases still accepted by the env loader
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Server secrets (never NEXT_PUBLIC_)
ENCRYPTION_SECRET=
LEAD_WEBHOOK_SECRET=

# Hermes internal agent runtime. Hermes is a separate private service; browsers
# must call AlphaClone /api/agents routes, never Hermes directly.
HERMES_LOCAL_MODE=true
HERMES_LOCAL_AUTO_KICK=true
HERMES_LOCAL_KICK_LIMIT=3
HERMES_INTERNAL_URL=
HERMES_INTERNAL_API_KEY=
HERMES_GLOBAL_DISABLED=false
HERMES_MAX_CONCURRENT_TASKS=1
HERMES_MAX_TASK_SECONDS=300
# Bonnie uses the OpenAI Agents SDK for orchestration with DeepSeek inference.
# Set BONNIE_AGENT_RUNTIME=legacy only for emergency rollback.
BONNIE_AGENT_RUNTIME=openai-agents
DEEPSEEK_AGENT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
