# Production environment — authentication / OAuth (Alphaclone Systems)

# Canonical public origin (server prefers PUBLIC_APP_ORIGIN)
PUBLIC_APP_ORIGIN=https://alphaclonesystems.com
NEXT_PUBLIC_APP_URL=https://alphaclonesystems.com
NEXT_PUBLIC_SITE_URL=https://alphaclonesystems.com
PUBLIC_MCP_RESOURCE=https://alphaclonesystems.com/api/mcp

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy aliases still accepted by ENV loader:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Secrets (server-only — never NEXT_PUBLIC_)
ENCRYPTION_SECRET=                 # exactly 32 characters
OAUTH_STATE_SECRET=                # optional; falls back to ENCRYPTION_SECRET (32 chars)
CRON_SECRET=
INTERNAL_API_KEY=

# Redis (Upstash) — lazy-loaded; set REDIS_REQUIRED=true to fail closed in prod
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_REQUIRED=true

# Optional MCP / OAuth extras
# ALLOW_MCP_RESOURCE_CROSS_ORIGIN=false
# MCP_TOKEN_SIGNING_SECRET=

# Provider credentials (configure callbacks to OAUTH_CALLBACKS registry URLs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://alphaclonesystems.com/api/auth/linkedin/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=https://alphaclonesystems.com/api/auth/zoho/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# VITE_CALENDLY_REDIRECT_URI=https://alphaclonesystems.com/api/auth/calendly/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=https://alphaclonesystems.com/api/slack/oauth/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Platform
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
BREVO_PLATFORM_API_KEY=
