# Bonnie / Alphaclone — Railway environment

# Core
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
CRON_SECRET=
INTERNAL_API_KEY=
ENCRYPTION_SECRET=

# MCP action emails (plain English on every write; set false for errors-only)
MCP_NOTIFY_EVERY_ACTION=true

BONNIE_MAX_AGENT_TOOLS=80

# Bonnie durable runtime (PostgreSQL + Railway worker/crons)
# Authoritative engine — do NOT set Temporal/BullMQ as competing sources of truth
BONNIE_DURABLE_RUNTIME=true
BONNIE_WORKER_POLL_MS=5000
BONNIE_MAX_TASKS_PER_RUN=200
BONNIE_MAX_PARALLEL_TASKS=20
BONNIE_MAX_RETRIES=5
BONNIE_MAX_GRAPH_DEPTH=12
BONNIE_EVENT_SIGNING_SECRET=
BONNIE_INTERNAL_SERVICE_TOKEN=

# Railway Redis (required for cron locks, durable publish queue, rate limits)
# On alphaclone-nextjs → Variables, add references to the Redis service:
# REDIS_URL=redis://${{Redis.REDISUSER}}:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:${{Redis.REDISPORT}}
# REDISHOST=${{Redis.RAILWAY_PRIVATE_DOMAIN}}
# REDISPORT=${{Redis.REDISPORT}}
# REDISUSER=${{Redis.REDISUSER}}
# REDISPASSWORD=${{Redis.REDIS_PASSWORD}}
# REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}
# REDIS_REQUIRED=true
# REDIS_CONNECT_TIMEOUT_MS=15000
#
# Alternative: Upstash REST (only if not using Railway Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# AI providers (configure only what you use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# App URL must be Railway/public HTTPS
NEXT_PUBLIC_APP_URL=https://alphaclonesystems.com
