{
  "expo": {
    "name": "AlphaClone Mobile",
    "slug": "alphaclone-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../public/favicon-512x512.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "../public/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#020D1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphaclone.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../public/favicon-512x512.png",
        "backgroundColor": "#020D1A"
      },
      "package": "com.alphaclone.mobile"
    },
    "web": {
      "favicon": "../public/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
