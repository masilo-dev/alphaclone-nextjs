{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "services": {
    "alphaclone-web": {
      "source": {
        "repo": ".",
        "rootDirectory": "."
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": "npm run start",
        "healthcheckPath": "/api/health"
      }
    },
    "alphaclone-scraper": {
      "source": {
        "repo": ".",
        "rootDirectory": "alphaclone-scraper"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/health"
      }
    }
  }
}
