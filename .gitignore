# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ignore windows nul device
nul

# PWA service worker build artifacts
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/pdfjs/

# Credentials and secrets
creds-output.txt
*creds*.txt
*secrets*.txt
*credentials*.txt

# Build logs
*.log
build_*.log
build_error*.log
build_output.log
tsc.log
dev_*.log
dev_error*.log

# Lint output
lint_*.txt
lint_*.json
eslint_*.txt

# Error files
ts_errors.txt
*_errors.txt
*_errors.csv
*_errors.json
critical_errors.*
current_ts*.txt
current_tsc*.txt

# Test artifacts
/playwright-report/
/test-results/

# Misc output files
diff.txt
conflicts.txt
build_log_v*.txt
build_err*.txt
build_check*.log
error_read.txt

# OS files
Thumbs.db

# IDE
.vscode/
.idea/

# Scratch and temporary files
/scratch/
.aider*

# workflow library generates a root /app dir at runtime; must not be committed
/app/
