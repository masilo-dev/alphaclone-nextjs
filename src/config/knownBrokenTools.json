  "create_post_with_ai_image": {
    "symptom": "invalid hd param",
    "action": "sanitize_args",
    "reason": "Strip unsupported hd param before image generation.",
    "workaround": {
      "stripArgs": ["hd"]
    }
  },
  "generate_contract_draft": {
    "symptom": "timeout",
    "action": "redirect",
    "reason": "Contract draft times out; prefer nexus_contract_drafter.",
